# Supabase (requeridas también para `next build`; valores dummy sirven para compilar)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Notificaciones push (rutas /api/notify y /api/cron/recordatorio)
# Generar par de claves: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Protege el endpoint del cron de Vercel (/api/cron/recordatorio)
CRON_SECRET=
