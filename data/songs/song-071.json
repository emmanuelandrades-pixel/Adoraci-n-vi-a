          ],
          "contenido": "Majo y Dan\nSolía vivir la vida en temor\nY me encontró\nUn camino mejor"
        },
        {
          "id": "s002",
          "tipo": "verso",
          "numero": 1,
          "acordes": [
            "C",
            "G",
            "D"
          ],
          "contenido": "Y crucificado junto a ti\nYa no vivo yo\nTú vives en mí"
        },
        {
          "id": "s003",
          "tipo": "verso",
          "numero": 2,
          "acordes": [
            "C",
            "G",
            "D"
          ],
          "contenido": "Toda mi carga Y condenación\nCambiada fue\npor tu gracia y perdón"
