        {
          "id": "s004",
          "tipo": "verso",
          "numero": 3,
          "acordes": [
            "C",
            "D",
            "Em",
            "Bm"
          ],
          "contenido": "Y no hay nada más\nQue pueda aportar\nTu gracia Jesús\nMe bastará"
        },
        {
          "id": "s005",
          "tipo": "verso",
          "numero": 4,
          "acordes": [
            "D",
            "Em",
            "C",
            "G"
          ],
          "contenido": "Y no me hace falta nada ya\nNo yo sino Cristo\nNo yo sino Cristo\nLo que fui no soy más\nTú en mí vivo estás\nNo yo solo Cristo"
        },
        {
          "id": "s006",
